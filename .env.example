# Copy to .env and fill in. Never commit or share this file.
TWELVE_DATA_API_KEY=your_key_here

# Only "paper" is implemented. Live trading is intentionally NOT included yet.
MODE=paper

# What to trade: edit the WATCHLIST from the dashboard (saved in watchlist.json). Daily data credits of your plan:
TD_CREDITS_PER_DAY=800

INITIAL_EQUITY=1000
RISK_PCT=0.005
MAX_LEVERAGE=5
DAILY_LOSS_CAP=0.03

# --- speed / data plan (see README section 7) ---
# Your Twelve Data plan's credits per minute (free plan = 8). Raise it if you pay for more.
TD_CREDITS_PER_MIN=8
# How often to fetch the live price while a position is open (seconds). Real rate = max(this, what the budget allows).
# Free plan = 800 credits/DAY as well. A 15-min strategy does not need 2-s prices: 20 s keeps a full
# session under the daily cap (~26 bar calls + <=1170 quotes only while a position is open). Paid plan -> 2.
QUOTE_POLL_SEC=20
# Wait after a bar closes before trusting it (seconds).
BAR_SETTLE_SEC=1.0

# Optional: free real-time BTC data from Binance (no key). Re-run the backtest on the same source first.
# PROVIDER_BTC_USD=binance
# POLL_SEC_BTC_USD=1
# BINANCE_BASE=https://data-api.binance.vision

# Optional Telegram alerts (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram is also the REMOTE CONTROL: /status /trades /stop /start /flatten /halt /resume
# (only messages from TELEGRAM_CHAT_ID are obeyed). Get your chat id by messaging @userinfobot.

# --- guardian: automatic emergency intervention (all optional, defaults shown) ---
# GUARD_MAX_DRAWDOWN_PCT=6        # from equity peak -> HALT (delete HALT file or /resume to continue)
# GUARD_SHOCK_ATR=3               # live move > N x ATR within GUARD_SHOCK_WINDOW_SEC -> exit if against us
# GUARD_SHOCK_WINDOW_SEC=120
# GUARD_SHOCK_COOLDOWN_MIN=30
# GUARD_DECAY_WINDOW=12           # last N trades of a symbol ...
# GUARD_DECAY_MIN_AVG_R=-0.35     # ... averaging below this -> pause the symbol
# GUARD_DECAY_PAUSE_H=12
# GUARD_SYM_DAILY_LOSS_R=3
# GUARD_STREAK_LOSSES=5           # N losses within GUARD_STREAK_WINDOW_H hours -> pause everything
# GUARD_STREAK_WINDOW_H=6
# GUARD_STREAK_COOLDOWN_H=3
# If TELEGRAM_CHAT_ID is a GROUP, also set your personal user id so only you can send commands:
# TELEGRAM_OWNER_ID=
